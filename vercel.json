{
  "cleanUrls": true,
  "rewrites": [{ "source": "/v/:id", "destination": "/api/watch?id=:id" }],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
